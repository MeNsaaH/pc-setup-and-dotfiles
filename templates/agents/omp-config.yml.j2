bash:
  patterns:
    - match: terraform state mv*
      approval: deny
    - match: "*terraform *state mv*"
      approval: deny
    - match: terraform state rm*
      approval: deny
    - match: "*terraform *state rm*"
      approval: deny
    - match: terraform state push*
      approval: deny
    - match: "*terraform *state push*"
      approval: deny
    - match: terraform state pull*
      approval: deny
    - match: "*terraform *state pull*"
      approval: deny
    - match: terraform state show*
      approval: deny
    - match: "*terraform *state show*"
      approval: deny
    - match: terraform state replace-provider*
      approval: deny
    - match: "*terraform *state replace-provider*"
      approval: deny
    - match: terraform state identities*
      approval: deny
    - match: "*terraform *state identities*"
      approval: deny
    - match: terraform import*
      approval: deny
    - match: "*terraform *import*"
      approval: deny
    - match: terraform force-unlock*
      approval: deny
    - match: "*terraform *force-unlock*"
      approval: deny
    - match: terraform taint*
      approval: deny
    - match: "*terraform *taint*"
      approval: deny
    - match: terraform untaint*
      approval: deny
    - match: "*terraform *untaint*"
      approval: deny
    - match: aws-vault exec *admin* *
      approval: deny
    - match: aws * --profile *admin*
      approval: deny
    - match: AWS_PROFILE=*admin* *
      approval: deny
    - match: git push --force*
      approval: deny
    - match: git push -f*
      approval: deny
    - match: terraform apply*
      approval: prompt
    - match: terraform destroy*
      approval: prompt
    - match: kubectl apply *
      approval: prompt
    - match: kubectl delete *
      approval: prompt
    - match: kubectl edit *
      approval: prompt
    - match: git push * main*
      approval: prompt
    - match: git push * master*
      approval: prompt
    - match: git push main*
      approval: prompt
    - match: git push master*
      approval: prompt
    - match: terraform state list*
      approval: allow
    - match: "* terraform state list*"
      approval: allow
    - match: python3
      approval: allow
    - match: python3 *
      approval: allow
    - match: xargs cat *
      approval: allow
    - match: helm
      approval: allow
    - match: helm *
      approval: allow
{% if agent_config.omp_disabled_providers %}
disabledProviders:
{% for p in agent_config.omp_disabled_providers %}
  - {{ p }}
{% endfor %}{% endif %}
{% if agent_config.omp_enabled_models %}
enabledModels:
{% for m in agent_config.omp_enabled_models %}
  - {{ m }}
{% endfor %}{% endif %}
hideThinkingBlock: true
update:
  auto: true