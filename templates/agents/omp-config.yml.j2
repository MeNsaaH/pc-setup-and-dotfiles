setupVersion: 3
{% if agent_config.omp_enabled_providers %}
enabledProviders:
{% for p in agent_config.omp_enabled_providers %}
  - {{ p }}
{% endfor %}{% endif %}
{% if agent_config.models.omp_default %}
modelRoles:
{% if agent_config.models.omp_slow %}
  slow: {{ agent_config.models.omp_slow }}
{% endif %}
{% if agent_config.models.omp_small %}
  smol: {{ agent_config.models.omp_small }}
{% endif %}
{% if agent_config.models.omp_vision %}
  vision: {{ agent_config.models.omp_vision }}
{% endif %}
  default: {{ agent_config.models.omp_default }}
{% endif %}
{% if agent_config.omp_extensions %}
extensions:
{% for e in agent_config.omp_extensions %}
  - {{ e }}
{% endfor %}{% endif %}
