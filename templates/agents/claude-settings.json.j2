  "model": "{{ agent_config.models.claude }}",
{% if agent_config.claude_model_settings %}
  "modelSettings": {{ agent_config.claude_model_settings | to_nice_json }},
{% endif %}
  "theme": "dark",
  "voice": {"mode": "hold", "autoSubmit": true},
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{ ansible_env.HOME }}/.hindsight/coding-agents/dist/claude-sessionstart-hook.js\"",
          "timeout": 30
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{ ansible_env.HOME }}/.hindsight/coding-agents/dist/claude-stop-hook.js\"",
          "timeout": 60
        }
      ]
    }
  ],
  "StopFailure": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{ ansible_env.HOME }}/.config/iterm2/cc-status"
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"{{ ansible_env.HOME }}/.hindsight/coding-agents/dist/claude-hook.js\"",
          "timeout": 30
        }
      ]
    }
  ]
}
}
